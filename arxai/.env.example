# ARX AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit real secrets. Replit secrets are managed via the Secrets panel.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/arxai

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-long-random-secret

# ── Registration Key Shield ───────────────────────────────────────────────
# Pepper for ARX-XXXX-XXXX-XXXX registration keys.
# Required when ARX_BETA_INVITE_REQUIRED=true.
# Generate: openssl rand -hex 32
REGISTRATION_KEY_PEPPER=replace-with-long-random-secret

# Enable the registration key gate (blocks signup without a valid key).
# ARX_BETA_INVITE_REQUIRED=true

# ── Admin bootstrap ───────────────────────────────────────────────────────
# ARX_ADMIN_EMAIL=admin@example.com
# ARX_ADMIN_INITIAL_PASSWORD=ChangeMe123!

# ── Phase B live broker execution (default-deny) ──────────────────────────
# Set to "true" ONLY for controlled owner/admin live testing.
# ARX_LIVE_BROKER_EXECUTION_ENABLED=false

# ── Economic calendar ─────────────────────────────────────────────────────
# FRED (free, dates only):
# FRED_API_KEY=your-fred-api-key
# ECONOMIC_CALENDAR_PROVIDER=fred

# Trading Economics (premium):
# TRADING_ECONOMICS_KEY=your-te-key
# ECONOMIC_CALENDAR_PROVIDER=te

# ── Email (Resend) ────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
