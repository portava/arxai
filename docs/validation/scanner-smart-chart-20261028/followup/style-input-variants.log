await (async page=>{
 const style=page.getByTestId('scanner-chart-panel').getByLabel('Chart style',{exact:true});
 const variants=[];
 for(const name of ['click-down-enter','space-down-enter','down-down-enter','letter-b-enter']){
  await page.keyboard.press('Escape');await style.selectOption('candles');await style.focus();
  await page.evaluate(()=>{window.__styleEvents=[];});
  if(name==='click-down-enter'){await style.click();await page.keyboard.press('ArrowDown');}
  if(name==='space-down-enter'){await page.keyboard.press('Space');await page.keyboard.press('ArrowDown');}
  if(name==='down-down-enter'){await page.keyboard.press('ArrowDown');await page.keyboard.press('ArrowDown');}
  if(name==='letter-b-enter')await page.keyboard.press('b');
  await page.keyboard.press('Enter');await page.keyboard.press('Tab');
  variants.push({name,value:await style.inputValue(),state:await page.evaluate(()=>window.__arxChartQa.snapshot().style),events:await page.evaluate(()=>window.__styleEvents)});
 }
 return variants;
}
)(page);
